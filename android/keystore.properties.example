# Android release-signing config (SVC-160).
#
# Copy this file to `keystore.properties` (git-ignored) and fill in the
# path to your keystore + the alias inside it. Do NOT put the passwords
# here — this file, even without secrets, has been known to leak by
# accident. Passwords come from environment variables only:
#
#   ANDROID_KEYSTORE_STORE_PASSWORD
#   ANDROID_KEYSTORE_KEY_PASSWORD
#
# See `RELEASE.md` for the shell-rc snippet + the full build flow.

# Path to the keystore file, relative to `android/app/` (Gradle's module
# root — that's where `file(...)` resolves from). If you followed the
# setup guide, the keystore is under `android/keystore/` — one level up
# from the module — so the path starts with `../`.
storeFile=../keystore/eazyserv-release.jks

# Key alias inside the keystore. Matches the `-alias` flag used to generate
# it. If you used the recommended alias this is already correct.
keyAlias=eazyserv
