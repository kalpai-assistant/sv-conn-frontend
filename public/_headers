# Cache policy for Cloudflare Pages / Netlify.
#
# Fingerprinted assets under /assets/ get an aggressive year-long cache;
# their names change on every build so this is safe. index.html + the
# service worker stay no-cache so a redeploy actually reaches every user
# on next load — a cached SW that has gone bad is very hard to recover
# from otherwise.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/firebase-messaging-sw.js
  Cache-Control: no-cache
