# Backend API Base URL
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Razorpay Key (Public)
VITE_RAZORPAY_KEY_ID=""

# Firebase / FCM (for push notifications). All values sourced from
# `firebase apps:sdkconfig WEB <app-id>` output. See backend/FIREBASE.md.
# These are shipped in the client bundle — not secrets, just per-project
# identifiers. `.gitignore` still keeps firebase-config.json out of git
# because CI injection is the source of truth.
#
# The VAPID public key is the ONE thing that isn't in firebase-config.json —
# generated separately via Firebase Console → Project Settings → Cloud
# Messaging → Web Push certificates. Public half of a key pair; safe to commit.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_VAPID_KEY=""

# Sentry — client-side error reporting. Empty = disabled (dev-safe default).
# Grab DSN from Sentry project settings. Keep trace sample rate low in prod
# (billing); bump for debugging.
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT="dev"
VITE_SENTRY_TRACES_SAMPLE_RATE="0"
# Release tag on every Sentry event. Must equal the `release.name` passed
# to @sentry/vite-plugin at build time so uploaded source maps are
# associated with events from this build. Recommended: set to APP_VERSION
# (e.g. `1.0.0-beta`) or the git sha in CI.
VITE_SENTRY_RELEASE=""

# Sentry source-map upload — CI-only, do NOT set locally.
# If all three of SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT are
# present at build time, @sentry/vite-plugin uploads symbolicated source
# maps under `release.name = $VITE_SENTRY_RELEASE`. If any is missing,
# upload silently skips — local + preview builds work unchanged.
#
# Create the auth token at https://sentry.io/settings/account/api/auth-tokens/
# with scope `project:releases`. Store as a GitHub Actions secret; do NOT
# put a real value here — this file is committed.
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# SVC-161: URL of the signed release APK on S3 (SVC-160 provides). Empty
# = /download page shows "coming very soon" instead of a broken link.
# Example: https://eazyserv-downloads.s3.ap-south-1.amazonaws.com/apk/latest.apk
VITE_APK_URL=""
