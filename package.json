{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:marketing": "vite build --config vite.marketing.config.ts && mv dist-marketing/index.marketing.html dist-marketing/index.html",
    "build:mobile": "vite build --config vite.mobile.config.ts && cp dist-mobile/index.mobile.html dist-mobile/index.html",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "generate:api-types": "openapi-typescript svc_connect.json -o src/types/api.ts",
    "doctor": "bash scripts/doctor.sh",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:android": "npm run build:mobile && npx cap sync && npx cap open android",
    "cap:ios": "npm run build:mobile && npx cap sync && npx cap open ios",
    "cap:assets": "npx @capacitor/assets generate --iconBackgroundColor '#7C3AED' --iconBackgroundColorDark '#6D28D9' --splashBackgroundColor '#7C3AED' --splashBackgroundColorDark '#6D28D9'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
